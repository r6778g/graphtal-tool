DATABASE_URL=postgresql://user:password@host:5432/graphtal
REDIS_URL=redis://host:6379
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-project-region
SUPABASE_STORAGE_BUCKET=graphtal-private-models
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
# Preferred server-side issuer URL. If omitted, NEXT_PUBLIC_SUPABASE_URL or the
# project reference in SUPABASE_STORAGE_ENDPOINT or a Supabase DATABASE_URL is used.
SUPABASE_URL=https://your-project.supabase.co
# Optional: set only when the project signs access tokens with HS256.
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://graphtal-tool.vercel.app,http://localhost:3000
MODEL_REGISTRY_REFRESH_SECONDS=30
MODEL_MIN_TEST_R2=-1
MAX_TRAINING_ROWS=100000
MAX_EXCEL_UNCOMPRESSED_BYTES=268435456
MAX_ACTIVE_TRAINING_JOBS_PER_USER=3
TRAINING_TIMEOUT_SECONDS=1800
# Optional local developer cache:
# MODEL_CACHE_DIR=/absolute/path/to/model-cache
